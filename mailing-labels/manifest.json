{
  "name": "mailing-labels",
  "label": "Mailing Labels",
  "type": "widget",
  "version": "1.1.5",
  "exbVersion": "1.21.0",
  "author": "Brian McLeer",
  "description": "Generate mailing labels from web map layer data with address search, partial sheet support, Avery formats, and CSV or PDF output.",
  "properties": {
    "supportInlineEditing": false,
    "supportRepeat": false,
    "canCrossFilter": false
  },
  "translatedLocales": [
    "en",
    "ar",
    "bg",
    "bs",
    "ca",
    "cs",
    "da",
    "de",
    "el",
    "es",
    "et",
    "fi",
    "fr",
    "he",
    "hr",
    "hu",
    "id",
    "it",
    "ja",
    "ko",
    "lt",
    "lv",
    "no",
    "nl",
    "pl",
    "pt-br",
    "pt-pt",
    "ro",
    "ru",
    "sk",
    "sl",
    "sr",
    "sv",
    "th",
    "tr",
    "zh-cn",
    "uk",
    "vi",
    "zh-hk",
    "zh-tw"
  ],
  "defaultLocale": "en",
  "dependencies": [
    "jimu-core",
    "jimu-ui",
    "jimu-arcgis"
  ],
  "hasStyle": true,
  "hasConfig": true,
  "hasSettingPanel": true,
  "settingUiPath": "setting/setting",
  "supportDataSource": true,
  "useDataSources": [
    {
      "types": [
        "WebMap"
      ]
    }
  ]
}
